{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avm.example/specification/interoperability-evidence-1.0.schema.json",
  "title": "AVM Interoperability Evidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "evidence_id", "profile_id", "generated_at_utc", "scope", "implementations", "vectors", "pilot_organizations", "approvals"],
  "properties": {
    "contract": { "const": "avm-interoperability-evidence-1.0" },
    "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "scope": { "enum": ["technical-reference-baseline", "industry-pilot"] },
    "implementations": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/implementation" }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    },
    "pilot_organizations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/approval" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "name", "version", "language", "organization_id", "source_digest", "codebase_uri"],
      "properties": {
        "implementation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "language": { "type": "string", "minLength": 1, "maxLength": 64 },
        "organization_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "codebase_uri": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "outcome"],
      "properties": {
        "implementation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "digest": { "$ref": "#/$defs/sha256" },
        "error_code": { "type": "string", "pattern": "^AVM-[A-Z]+-[0-9]{4}$" }
      },
      "oneOf": [
        { "required": ["digest"], "not": { "required": ["error_code"] } },
        { "required": ["error_code"], "not": { "required": ["digest"] } }
      ]
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector_id", "subject", "subject_sha256", "results"],
      "properties": {
        "vector_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subject": { "type": "string", "pattern": "^[^:\\\\]+$" },
        "subject_sha256": { "$ref": "#/$defs/sha256" },
        "results": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/result" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_id", "organization_id", "role", "approved_at_utc", "independence_attested"],
      "properties": {
        "approver_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organization_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approved_at_utc": { "type": "string", "format": "date-time" },
        "independence_attested": { "const": true }
      }
    }
  }
}
