{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://av.example/schema/module-manifest-v1.json",
  "title": "AV Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "schema_version",
    "module_version",
    "display_name",
    "minimum_core_version",
    "processes_file",
    "rules_file",
    "reports_file",
    "strings_file"
  ],
  "properties": {
    "module_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "schema_version": { "const": 1 },
    "module_version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "minimum_core_version": { "type": "string", "minLength": 1 },
    "processes_file": { "type": "string", "minLength": 1 },
    "rules_file": { "type": "string", "minLength": 1 },
    "reports_file": { "type": "string", "minLength": 1 },
    "strings_file": { "type": "string", "minLength": 1 }
  }
}
