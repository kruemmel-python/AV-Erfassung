{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://av.example/schema/processes-v1.json",
  "title": "AV Process Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["interruption_types", "shift_types", "work_items"],
  "properties": {
    "interruption_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "productive"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "display_name": { "type": "string", "minLength": 1 },
          "productive": { "type": "boolean" },
          "note_required": { "type": "boolean", "default": false }
        }
      }
    },
    "shift_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "start_local", "end_local"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "display_name": { "type": "string", "minLength": 1 },
          "start_local": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
          "end_local": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
          "day_offset_end": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "target_duration_seconds", "requires_employee_id", "allowed_interruptions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "display_name": { "type": "string", "minLength": 1 },
          "target_duration_seconds": { "type": "integer", "minimum": 1 },
          "requires_employee_id": { "type": "boolean" },
          "allowed_interruptions": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "display_name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "number", "boolean", "date", "choice"] },
        "display_name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "max_length": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
